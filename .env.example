# ------------------------------------------------------------------
# Objektuebernahme: Startparameter (Vorlage, docs/betrieb.md 3.7). Nach .env kopieren, Werte eintragen.
# Keine Geheimnisse in dieser Datei (Secrets: docs/betrieb.md 3.8).
# Fachliche Konfiguration liegt in app_settings, nicht hier (Beschluss B-06).
# Serverwerte stammen aus dem Ergebnisblatt des Serverbefunds (scripts/measure_server.sh).
# ------------------------------------------------------------------

# --- Deployment ---
IMAGE_TAG=                       # setzt scripts/deploy.sh (Git-SHA, 12 Zeichen)
APP_UID=10001                    # UID der Anwendungscontainer; ANNAHME AB1; muss zu chown unter /srv/objektakte passen
APP_ENV=production               # production | staging | development
TZ=Europe/Berlin                 # Sollwert; Ist-Wert aus timedatectl (Ergebnisblatt)
APP_DOMAIN=uebernahme.muellerhv.de
APP_BASE_URL=https://uebernahme.muellerhv.de
TESSDATA_VARIANT=debian          # debian | fast | standard; Entscheidung nach M0 (F18)
JOB_DISPATCH=celery              # celery (Betrieb) | none (nur Tests und lokaler Messlauf perf_run --local)

# --- Traefik (Werte aus dem Serverbefund, docs/betrieb.md 1.6) ---
TRAEFIK_NETWORK=                 # Name des externen Docker-Netzes von Traefik
TRAEFIK_ENTRYPOINT=              # Name des HTTPS-Entrypoints (Port 443)
TRAEFIK_ENTRYPOINT_INSECURE=     # Name des HTTP-Entrypoints (Port 80), nur fuer den Redirect-Router
TRAEFIK_CERTRESOLVER=            # Name des Let's-Encrypt-Resolvers
TRAEFIK_REDIRECT_ROUTER=         # true, wenn Traefik keinen globalen Redirect hat; sonst false und Labels entfernen
TRUSTED_PROXY_CIDR=              # Subnetz des Traefik-Netzes aus docker network inspect

# --- Image-Tags (aktuelle LTS bzw. stabile Version zum Umsetzungszeitpunkt pruefen) ---
MARIADB_TAG=
REDIS_IMAGE=redis                # redis oder kompatibler Fork (docs/betrieb.md Anhang C)
REDIS_TAG=

# --- Datenbank (nicht geheim; Passwoerter als Secrets) ---
DB_NAME=objektakte
DB_USER=app_rw                   # web, beat
DB_WORKER_USER=app_worker        # worker, worker-nlp, worker-io, classifier
DB_MIGRATE_USER=app_migrate      # nur deploy.sh, Schritt Migration
DB_BACKUP_USER=app_backup        # nur backup
DB_MAX_CONNECTIONS=              # Formel: GUNICORN_WORKERS x GUNICORN_THREADS + OCR_PROCESSES + NLP_CONCURRENCY + IO_CONCURRENCY + 10
DB_INNODB_BUFFER_POOL=           # Formel: 0,5 x DB_MEM, Schreibweise z. B. 1G

# --- Prozessdimensionierung (Formel docs/betrieb.md 3.10, aus nproc und free -h) ---
GUNICORN_WORKERS=3               # ANNAHME AB4
GUNICORN_THREADS=4               # ANNAHME AB4 (gthread)
GUNICORN_TIMEOUT=120             # ANNAHME AB23 (Sekunden)
OCR_PROCESSES=                   # P = max(1, C minus 1); nur hier, nicht in app_settings
NLP_CONCURRENCY=1                # L = 1; 2 ab C groesser oder gleich 6 (ANNAHME AB3)
IO_CONCURRENCY=4                 # ANNAHME AB5; Drive-Quota beachten
WORKER_MAX_TASKS_PER_CHILD=50    # ANNAHME AB23
WORKER_MAX_MEMORY_PER_CHILD_KB=  # m_ocr in KB (Messwert aus M0; ANNAHME AB2: 786432 fuer 0,75 GiB)
WORKER_STOP_GRACE=120s           # ANNAHME AB23
JOBS_VISIBILITY_TIMEOUT_S=3600   # ANNAHME A19, deutlich ueber der laengsten Chunk-Laufzeit

# --- Ressourcenlimits (Formel docs/betrieb.md 3.10) ---
WEB_CPUS=
WEB_MEM=
WORKER_CPUS=
WORKER_MEM=
WORKER_NLP_CPUS=
WORKER_NLP_MEM=
WORKER_IO_CPUS=
WORKER_IO_MEM=
BEAT_CPUS=
BEAT_MEM=
DB_CPUS=
DB_MEM=
REDIS_CPUS=
REDIS_MEM=
REDIS_MAXMEMORY=                 # REDIS_MEM minus 56 MiB, Schreibweise z. B. 200mb
BACKUP_CPUS=
BACKUP_MEM=
CLASSIFIER_CPUS=                 # nur bei Profil classifier
CLASSIFIER_MEM=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_MAX_SIZE=20m                 # ANNAHME AB22
LOG_MAX_FILE=5                   # ANNAHME AB22

# --- Speicherplatz ---
DISK_RESERVE_GB=                 # max(10, 0,1 x D); Ingest stoppt, wenn weniger frei ist

# --- Backup ---
BACKUP_CRON=30 2 * * *           # ANNAHME AB10: taeglich 02:30 Serverzeit
BACKUP_RETENTION_DAYS=30         # Entscheidung Auftraggeber (F26), Vorschlag 30
BACKUP_MAX_AGE_HOURS=26          # ANNAHME AB10; Healthcheck rot, wenn die letzte Sicherung aelter ist
OFFSITE_ENABLED=false            # bis zur Entscheidung F26
OFFSITE_REMOTE=                  # rclone-Remote und Pfad, nur bei OFFSITE_ENABLED=true

# --- Google Drive und OAuth (docs/betrieb.md 7) ---
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=https://uebernahme.muellerhv.de/auth/google/callback
GOOGLE_LOGIN_REDIRECT_URI=https://uebernahme.muellerhv.de/auth/google/login/callback
DRIVE_ACCOUNT_EMAIL=ablage@muellerhv.de
DRIVE_SCOPES=https://www.googleapis.com/auth/drive
GOOGLE_LOGIN_ENABLED=false       # bis F14
GOOGLE_LOGIN_HOSTED_DOMAIN=muellerhv.de

# --- KI-Provider: nur Basis-URLs (B-06). Modell, Region, Timeout, Budget in app_settings ---
OPENAI_BASE_URL=                 # EU-Endpunkt, sobald vom Anbieter bestaetigt (V-12)
ANTHROPIC_BASE_URL=              # EU-Endpunkt, sobald vom Anbieter bestaetigt (V-12)
HVM_SIGNATURE_PATH=/run/secrets/hvm_signature   # Unterschriftsbild fuer freigegebene Nachforderungen (Secret, nie im Repository)
LISTS_AUTO_GENERATE=true         # Listen automatisch nach Lauf, Review, Import und Stammdatenaenderung (CR 12a)

# --- E-Mail (Alarmierung optional, F27) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_FROM=
ALERT_EMAIL_TO=
ALERTS_ENABLED=false

# --- Sitzungen und Login (ANNAHME AB13, Entscheidung F28) ---
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
REAUTH_TIMEOUT_SECONDS=900       # Step-up TOTP vor sensiblen Aktionen
MFA_REQUIRED=true
