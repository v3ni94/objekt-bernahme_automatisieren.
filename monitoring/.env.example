# Statusseite: Kopie als .env neben dieser Datei, Werte eintragen. Die .env bleibt ausserhalb des Repositorys.
# Kommentare stehen in eigenen Zeilen, damit kein Kommentartext in einen Wert geraet.

# Domain der Statusseite
STATUS_DOMAIN=status.mueller-holding.ag

# Traefik-Anbindung, Werte wie in /opt/objektakte/.env
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=
TRAEFIK_CERTRESOLVER=

# Messnetz mit festem Teilnetz; aendern, falls das Teilnetz auf dem Wirt schon belegt ist (Kontrolle siehe Anleitung)
STATUS_SUBNET=172.31.250.0/24
STATUS_GATEWAY=172.31.250.1

# Aufbewahrung der Messwerte (deckt die Ansicht "1 Jahr") und Obergrenze des Speichers
PROM_RETENTION_TIME=400d
PROM_RETENTION_SIZE=60GB
