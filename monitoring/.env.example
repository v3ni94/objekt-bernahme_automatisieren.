# Statusseite: Kopie als .env neben dieser Datei, Werte eintragen. Die .env bleibt ausserhalb des Repositorys.
# Kommentare stehen in eigenen Zeilen, damit kein Kommentartext in einen Wert geraet.

# Domain der Statusseite
STATUS_DOMAIN=status.mueller-holding.ag

# Traefik-Anbindung, Werte wie in /opt/objektakte/.env
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=
TRAEFIK_CERTRESOLVER=

# Messnetz mit festem Teilnetz; aendern, falls das Teilnetz auf dem Wirt schon belegt ist (Kontrolle siehe Anleitung)
STATUS_SUBNET=172.31.250.0/24
STATUS_GATEWAY=172.31.250.1

# Aufbewahrung der Messwerte (deckt die Ansicht "1 Jahr") und Obergrenze des Speichers
PROM_RETENTION_TIME=400d
PROM_RETENTION_SIZE=60GB

# Anmeldung ueber das CRM (Anleitung, Abschnitt "Anmeldung ueber das CRM"). Beide Zeilen gemeinsam umstellen.
# Oeffentlich (Stand 25.09.2026):
#   COMPOSE_PROFILES=
#   STATUS_MIDDLEWARES=mhag-status-ratelimit,mhag-status-headers
# Mit Anmeldung:
#   COMPOSE_PROFILES=sso
#   STATUS_MIDDLEWARES=mhag-status-fehler,mhag-status-auth,mhag-status-ratelimit,mhag-status-headers
COMPOSE_PROFILES=
STATUS_MIDDLEWARES=mhag-status-ratelimit,mhag-status-headers

# OIDC-Anbieter (Aussteller laut Discovery des CRM), Client-Kennung und Secret aus der Registrierung im CRM,
# Cookie-Schluessel des Proxys: openssl rand -base64 32 | tr -- '+/' '-_'
# Werte in einfache Anfuehrungszeichen setzen, falls sie ein Dollarzeichen enthalten.
STATUS_SSO_ISSUER=https://api.mueller-holding.ag
STATUS_SSO_CLIENT_ID=
STATUS_SSO_CLIENT_SECRET=
STATUS_SSO_COOKIE_SECRET=
