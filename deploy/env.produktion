# Produktionskonfiguration fuer den VPS 187.124.23.80 (Serverbefund vom 10.09.2026, docs/betrieb/serverbefund.md).
# Wird durch die Workflow-Aktion env-init einmalig nach /opt/objektakte/.env kopiert und danach nur dort gepflegt.
# Keine Geheimnisse in dieser Datei; Passwoerter und Schluessel liegen als Dateien unter /srv/objektakte/secrets.
# Keine Kommentare hinter Werten, damit Compose und deploy.sh die Werte unveraendert lesen.

# --- Deployment ---
IMAGE_TAG=
APP_UID=10001
APP_ENV=production
TZ=Europe/Berlin
APP_DOMAIN=uebernahme.muellerhv.de
APP_BASE_URL=https://uebernahme.muellerhv.de
TESSDATA_VARIANT=debian
JOB_DISPATCH=celery

# --- Traefik (Befund: Traefik 3.7 im Host-Netz, Entrypoints web und websecure, Resolver letsencrypt, globaler Redirect) ---
TRAEFIK_NETWORK=objektakte-proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_ENTRYPOINT_INSECURE=web
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_REDIRECT_ROUTER=false
TRUSTED_PROXY_CIDR=172.31.250.0/24

# --- Image-Tags ---
MARIADB_TAG=11.8
REDIS_IMAGE=redis
REDIS_TAG=7.4-alpine

# --- Datenbank ---
DB_NAME=objektakte
DB_USER=app_rw
DB_WORKER_USER=app_worker
DB_MIGRATE_USER=app_migrate
DB_BACKUP_USER=app_backup
DB_MAX_CONNECTIONS=40
DB_INNODB_BUFFER_POOL=1536M

# --- Prozessdimensionierung (C = 8, M = 31,3 GiB, Server wird mit anderen Anwendungen geteilt; docs/betrieb/serverbefund.md 6) ---
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
OCR_PROCESSES=4
NLP_CONCURRENCY=2
IO_CONCURRENCY=4
WORKER_MAX_TASKS_PER_CHILD=50
WORKER_MAX_MEMORY_PER_CHILD_KB=786432
WORKER_STOP_GRACE=120s
JOBS_VISIBILITY_TIMEOUT_S=3600

# --- Ressourcenlimits (Summe 10,5 GiB, unter 0,5 x M wegen der Mitnutzer des Servers) ---
WEB_CPUS=1.0
WEB_MEM=1024m
WORKER_CPUS=4
WORKER_MEM=3584m
WORKER_NLP_CPUS=2
WORKER_NLP_MEM=1946m
WORKER_IO_CPUS=0.5
WORKER_IO_MEM=512m
BEAT_CPUS=0.25
BEAT_MEM=128m
DB_CPUS=1.0
DB_MEM=3072m
REDIS_CPUS=0.5
REDIS_MEM=256m
REDIS_MAXMEMORY=200mb
BACKUP_CPUS=0.5
BACKUP_MEM=256m
CLASSIFIER_CPUS=1.0
CLASSIFIER_MEM=1536m

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_MAX_SIZE=20m
LOG_MAX_FILE=5

# --- Speicherplatz (D = 189,6 GiB frei) ---
DISK_RESERVE_GB=18

# --- Backup ---
BACKUP_CRON=30 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=26
OFFSITE_ENABLED=false
OFFSITE_REMOTE=

# --- Google Drive und OAuth (Client-ID folgt aus der Cloud Console, Secret als Datei) ---
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=https://uebernahme.muellerhv.de/auth/google/callback
GOOGLE_LOGIN_REDIRECT_URI=https://uebernahme.muellerhv.de/auth/google/login/callback
DRIVE_ACCOUNT_EMAIL=ablage@muellerhv.de
DRIVE_SCOPES=https://www.googleapis.com/auth/drive
GOOGLE_LOGIN_ENABLED=false
GOOGLE_LOGIN_HOSTED_DOMAIN=muellerhv.de

# --- KI-Provider (Basis-URLs erst nach V-12) ---
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
HVM_SIGNATURE_PATH=/run/secrets/hvm_signature
LISTS_AUTO_GENERATE=true

# --- E-Mail (Alarmierung aus, bis SMTP-Zugang vorliegt) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_FROM=
ALERT_EMAIL_TO=
ALERTS_ENABLED=false

# --- Sitzungen und Login ---
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
REAUTH_TIMEOUT_SECONDS=900
MFA_REQUIRED=true
